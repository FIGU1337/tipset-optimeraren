# Mall för .streamlit/secrets.toml (kopiera, döp om till secrets.toml och fyll i).
# Samma rader klistras in under "Secrets" när appen läggs på Streamlit Community Cloud.

# Nyckel från Google AI Studio (för AI-analys och Google-sökning av skador)
GEMINI_API_KEY = "din-gemini-nyckel"

# Master-inloggning: när detta är satt kräver alla AI-funktioner inloggning.
# Använd ett långt, unikt lösenord.
ADMIN_PASSWORD = "byt-till-ett-långt-lösenord"

# Sätt till true för att stänga av AI helt (t.ex. i en publik version utan inloggning).
# AI_DISABLED = true
